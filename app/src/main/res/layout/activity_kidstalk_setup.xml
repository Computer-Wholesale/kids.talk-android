<?xml version="1.0" encoding="utf-8"?>
<!-- Kids.Talk setup screen — four steps in one layout:
     Step 1: login_card        (username + password)
     Step 2: perm_mic_card     (microphone explanation)
     Step 3: perm_notif_card   (notifications explanation)
     Step 4: perm_fullscreen_card (full-screen-intent explanation) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kt_cream">

    <!-- ═══════════════════════════════════════════════════════════════════════
         STEP 1 — Login card
    ════════════════════════════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/login_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="28dp"
            android:paddingTop="56dp"
            android:paddingBottom="32dp">

            <!-- App icon -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:src="@drawable/linphone_splashscreen"
                android:contentDescription="Kids.Talk logo"
                android:layout_marginBottom="8dp" />

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/kt_teal"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.02"
                android:layout_marginBottom="6dp" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_tagline"
                android:textSize="15sp"
                android:textColor="@color/kt_dark"
                android:gravity="center"
                android:layout_marginBottom="40dp" />

            <!-- ── Login form card ──────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/kt_cream"
                android:foreground="@drawable/kt_card_border">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Username label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_username_label"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/kt_dark"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <!-- Username field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/username_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/setup_username_hint"
                        app:boxStrokeColor="@color/kt_teal"
                        app:boxStrokeWidth="2dp"
                        app:hintTextColor="@color/kt_teal"
                        android:layout_marginBottom="20dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/username_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6"
                            android:textSize="22sp"
                            android:textColor="@color/kt_dark"
                            android:letterSpacing="0.15"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setup_password_label"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/kt_dark"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <!-- Password field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/password_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/setup_password_hint"
                        app:boxStrokeColor="@color/kt_teal"
                        app:boxStrokeWidth="2dp"
                        app:hintTextColor="@color/kt_teal"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/kt_teal"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textSize="18sp"
                            android:textColor="@color/kt_dark"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Error message -->
                    <TextView
                        android:id="@+id/error_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#D32F2F"
                        android:textSize="13sp"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <!-- Progress bar -->
                    <ProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:indeterminateTint="@color/kt_teal"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp" />

                    <!-- Connect button -->
                    <Button
                        android:id="@+id/connect_button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/setup_connect_button"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/kt_cream"
                        android:backgroundTint="@color/kt_teal"
                        android:enabled="false"
                        android:stateListAnimator="@null"
                        android:elevation="0dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Help text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_help_text"
                android:textSize="12sp"
                android:textColor="@color/kt_dark"
                android:gravity="center"
                android:alpha="0.6"
                android:layout_marginTop="24dp" />

        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════════════════════════════════════
         STEP 2 — Microphone permission explanation
    ════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/perm_mic_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎤"
            android:textSize="64sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_perm_mic_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/kt_teal"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/kt_cream"
            android:foreground="@drawable/kt_card_border"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_perm_mic_body"
                    android:textSize="15sp"
                    android:textColor="@color/kt_dark"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_perm_mic_instruction"
                    android:textSize="13sp"
                    android:textColor="@color/kt_dark"
                    android:alpha="0.7"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/allow_mic_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/setup_perm_mic_allow_button"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/kt_cream"
            android:backgroundTint="@color/kt_teal"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/skip_mic_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_permission_skip_button"
            android:textColor="@color/kt_dark"
            android:alpha="0.6" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         STEP 3 — Notifications permission explanation
    ════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/perm_notif_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔔"
            android:textSize="64sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_perm_notif_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/kt_teal"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/kt_cream"
            android:foreground="@drawable/kt_card_border"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_perm_notif_body"
                    android:textSize="15sp"
                    android:textColor="@color/kt_dark"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_perm_notif_instruction"
                    android:textSize="13sp"
                    android:textColor="@color/kt_dark"
                    android:alpha="0.7"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/allow_notif_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/setup_perm_notif_allow_button"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/kt_cream"
            android:backgroundTint="@color/kt_teal"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/skip_notif_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_permission_skip_button"
            android:textColor="@color/kt_dark"
            android:alpha="0.6" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════════════
         STEP 4 — Full-screen alerts permission explanation
    ════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/perm_fullscreen_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞"
            android:textSize="64sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_permission_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/kt_teal"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/kt_cream"
            android:foreground="@drawable/kt_card_border"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_permission_body"
                    android:textSize="15sp"
                    android:textColor="@color/kt_dark"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setup_permission_instruction"
                    android:textSize="13sp"
                    android:textColor="@color/kt_dark"
                    android:alpha="0.7"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/allow_permission_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/setup_permission_allow_button"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/kt_cream"
            android:backgroundTint="@color/kt_teal"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/skip_permission_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_permission_skip_button"
            android:textColor="@color/kt_dark"
            android:alpha="0.6" />

    </LinearLayout>

</FrameLayout>

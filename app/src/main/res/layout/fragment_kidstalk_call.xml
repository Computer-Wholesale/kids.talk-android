<?xml version="1.0" encoding="utf-8"?>
<!--
  Kids.Talk — Single Contact Call Screen layout.
  Shows either the call_view (big call button) or setup_view (contact entry form).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Call view: shown when a contact is already saved -->
    <LinearLayout
        android:id="@+id/call_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/contact_name_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/call_button"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:text="@string/setup_connect_button"
            android:textSize="24sp" />

        <Button
            android:id="@+id/change_contact_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/kt_change_contact"
            style="?attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- Setup view: shown when no contact is configured -->
    <LinearLayout
        android:id="@+id/setup_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/setup_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/kt_contact_name_hint"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/setup_number_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/kt_contact_number_hint"
            android:inputType="phone"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/save_contact_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/kt_save_contact"
            android:enabled="false" />
    </LinearLayout>

</FrameLayout>

# KID-267 protected upload-key signing input names
#
# This file is documentation only. Do not create, commit, or source a real
# keystore.properties file. The protected release workflow provides these
# categories ephemerally from the approved organisation vault.
#
# KIDSTALK_UPLOAD_KEYSTORE_PATH=/protected/workspace/kidstalk-upload-key.jks
# KIDSTALK_UPLOAD_KEYSTORE_PASSWORD=<protected environment input>
# KIDSTALK_UPLOAD_KEY_ALIAS=<protected environment input>
# KIDSTALK_UPLOAD_KEY_PASSWORD=<protected environment input>
#
# Missing, empty, unreadable, or inconsistent inputs must fail closed before
# any release bundle packaging starts. Never use a debug, personal, guessed,
# temporary, or repository-stored signing identity.

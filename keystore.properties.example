# Kids.Talk — keystore.properties template
# Copy this file to keystore.properties and fill in the real values.
# keystore.properties is gitignored and must NEVER be committed.
#
# Key custody:
#   - The upload keystore (kidstalk-upload.jks) is held by the service operator.
#   - Passwords are stored in the team password vault (1Password / equivalent).
#   - Google Play App Signing is enabled: Google holds the unrecoverable app-signing key;
#     the upload key is resettable via Play Console if lost.
#   - Break-glass: contact the project owner to reset the upload key via Play Console.
#
# storeFile path is relative to the repository root.
storeFile=../kidstalk-upload.jks
storePassword=CHANGE_ME
keyAlias=kidstalk-upload
keyPassword=CHANGE_ME
